# 운영 배포용 환경변수 목록 (예시)
#
# 로컬 개발은 이 파일 없이 그대로 동작합니다 — application.yml 의 ${VAR:기본값} 기본값이
# docker compose 의 dev 인프라(localhost)를 가리키기 때문입니다.
# 운영 배포(docker-compose.prod.yml)는 같은 디렉터리의 .env 를 자동으로 읽습니다 —
# 이 파일을 .env 로 복사해 실값을 채우세요.
# ⚠️ 실제 값을 채운 .env 는 절대 커밋하지 마세요 (.gitignore 등록됨).

# ── 상태 저장소 (Postgres) — api / worker / admin 공통 ─────────────
DB_URL=jdbc:postgresql://your-db-host:5432/maildb
DB_USERNAME=maildb
DB_PASSWORD=change-me

# ── 발송 작업큐 (RabbitMQ) — api / worker ──────────────────────────
RABBITMQ_HOST=your-mq-host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mail
RABBITMQ_PASSWORD=change-me

# ── 이벤트 스트림 (Kafka) — api / worker ───────────────────────────
KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092

# ── 인증/웹훅 (mail-api) ────────────────────────────────────────────
# HS512 서명이라 64바이트 이상의 랜덤 문자열이어야 합니다. 생성 예:
#   openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=120
# 바운스 웹훅 공유 시크릿 (프로바이더가 X-Webhook-Token 헤더로 echo)
APP_WEBHOOK_SECRET=
# SES(SNS) 웹훅의 아마존 서명검증 — 운영은 반드시 true(기본값). 로컬에서 샘플
# 페이로드를 curl로 흘릴 때만 false로.
APP_WEBHOOK_SNS_VERIFY_SIGNATURE=true
# 수용할 SNS TopicArn 허용목록(쉼표 구분). 서명이 유효해도 우리 토픽이 아니면 거른다 —
# 안 걸면 남의 AWS 계정 토픽으로 우리 테넌트를 강제 정지시킬 수 있다. 운영은 반드시 지정.
# 예: arn:aws:sns:ap-northeast-2:123456789012:outpace-ses-bounces
APP_WEBHOOK_SNS_TOPIC_ARN=

# ── SMTP 발송 (mail-worker) ────────────────────────────────────────
# dev 기본은 MailHog(localhost:1025, 무인증). 운영은 실제 릴레이로.
SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# smtp | logging (logging 은 발송 없이 로그만)
MAIL_SENDER_TYPE=smtp

# ── 베타 가입 정원 (mail-api) ───────────────────────────────────────
# 워크스페이스 수가 이 값에 닿으면 신규 가입 차단(기존 로그인·멤버 추가는 무관).
# SES 평판 워밍업 기간의 발송량 통제 겸용. 0/미설정 = 무제한.
APP_BETA_SIGNUP_CAP=10

# ── 발신 주소 정책 (mail-api) ───────────────────────────────────────
# SES 는 검증된 도메인에서만 발송 가능 — 캠페인 발신 주소를 이 도메인으로 제한.
# 미설정 시 제한 없음(개발 기본). 고객 회신은 Reply-To 로 받는다.
APP_SENDER_DOMAIN=outpacemail.com

# 신규 워크스페이스 워밍업 — 누적 발송 200통 미만이면 캠페인당 수신자 50명 상한.
# 발송 평판 방어용이라 운영에서는 켠 채로 둘 것. false 로만 끌 수 있음.
APP_MAIL_WARMUP_ENABLED=true

# ── 시스템 메일 (mail-api) ──────────────────────────────────────────
# 재설정 메일 링크가 가리키는 콘솔 주소 — 운영은 APP_BASE_URL 과 같은 공개 도메인.
APP_CONSOLE_URL=https://mail.example.com

# ── 구글 로그인 (mail-api) ──────────────────────────────────────────
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급한 OAuth
# 클라이언트 ID. 미설정 시 구글 로그인 버튼만 비활성(이메일 가입은 정상).
# 프론트 빌드에도 같은 값이 필요: frontend/.env 의 VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ── 결제 (mail-api · 토스페이먼츠 빌링) ─────────────────────────────
# 미설정 시 토스 문서의 공용 테스트 키로 동작(실결제 없음). 운영은 개발자센터 발급 키.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 메트릭 (mail-worker) ───────────────────────────────────────────
# 워커의 유일한 HTTP 표면 — Prometheus 가 /actuator/prometheus 를 긁는 포트.
WORKER_METRICS_PORT=8082

# ── 모니터링 (docker-compose.prod.yml) ─────────────────────────────
# 프로드 Grafana 는 익명 접근이 꺼져 있고 admin 계정으로 로그인합니다.
GRAFANA_ADMIN_PASSWORD=change-me

# ── 추적/수신거부 링크의 공개 주소 (mail-worker) ────────────────────
# 수신자 메일 본문에 박히는 URL 이므로 반드시 외부에서 접근 가능한 주소여야 합니다.
APP_BASE_URL=https://mail.example.com
